<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.agidevelopment.bear_update</string>
      <!-- Daily touch: bumps today's daily + the current week/month/quarter notes -->
      <key>ProgramArguments</key>
      <array>
        <string>/Users/dgdosen/.dotfiles/daily/bear_update.sh</string>
      </array>
      <!-- Runs at 00:01, 01:01 and 02:01 -->
      <key>StartCalendarInterval</key>
      <array>
        <dict>
          <key>Hour</key>
          <integer>0</integer>
          <key>Minute</key>
          <integer>1</integer>
        </dict>
        <dict>
          <key>Hour</key>
          <integer>1</integer>
          <key>Minute</key>
          <integer>1</integer>
        </dict>
        <dict>
          <key>Hour</key>
          <integer>2</integer>
          <key>Minute</key>
          <integer>1</integer>
        </dict>
      </array>
    <key>StandardOutPath</key>
    <string>/Users/dgdosen/log/bear_update.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/dgdosen/log/bear_update.err</string>
    <key>SessionCreate</key>
    <true/>
  </dict>
</plist>
