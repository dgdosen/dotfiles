<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quantifiedflow.qf_echo_edition</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dgdosen/.dotfiles/daily/qf_echo_edition.sh</string>
    </array>
    <!-- Morning 07:30, Midday 12:00, Early Evening 16:00, Evening 22:00 -->
