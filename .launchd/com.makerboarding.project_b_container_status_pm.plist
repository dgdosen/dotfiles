<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Evening health check for all com.makerboarding.* Launch Agents.
         Appends to the Bear note created by the _am run earlier that day.
         Paired with the _am variant at 07:03. -->
    <key>Label</key>
    <string>com.makerboarding.project_b_container_status_pm</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/dgdosen/.dotfiles/daily/project_b_container_status.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>21</integer>
      <key>Minute</key>
      <integer>7</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/dgdosen/log/project_b_container_status.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dgdosen/log/project_b_container_status.error.log</string>
  </dict>
</plist>
