<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quantifiedflow.qf_echo_scrape</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dgdosen/.dotfiles/daily/qf_echo_scrape.sh</string>
    </array>
    <!-- hourly at :15, offset from edition times -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/dgdosen/log/qf_echo_scrape.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/dgdosen/log/qf_echo_scrape.err</string>
</dict>
</plist>
