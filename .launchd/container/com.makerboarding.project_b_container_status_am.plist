<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Morning health check for all com.makerboarding.* Launch Agents.
         Creates (or appends to) a Bear note: project_b_status_YYYY_MM_DD.
         Paired with the _pm variant at 21:07. -->
    <key>Label</key>
    <string>com.makerboarding.project_b_container_status_am</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/dgdosen/.dotfiles/daily/container/project_b_container_status.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>3</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/dgdosen/log/project_b_container_status.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dgdosen/log/project_b_container_status.error.log</string>
  </dict>
</plist>
