<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Ensures the podman machine is running before any container job fires.
         RunAtLoad covers login; the 05:50 interval pre-warms the VM before the
         earliest scraper (bris at 06:00) so no job has to cold-start the VM and
         risk ERR_NETWORK_CHANGED races from the network flap.
         Calls a guard script rather than `podman machine start` directly: start
         exits 125 on an already-running machine, so the bare command reported a
         daily false failure. The script checks state first and only reports
         non-zero on a real start failure. -->
    <key>Label</key>
    <string>com.makerboarding.project_b_podman.container</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/dgdosen/.dotfiles/daily/container/project_b_podman.container.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>50</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/dgdosen/log/project_b_podman.container.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dgdosen/log/project_b_podman.container.error.log</string>
  </dict>
</plist>
