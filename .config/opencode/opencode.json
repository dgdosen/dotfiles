{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "provider": {
    "local-dg-ms-m5m": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "dg-ms-m5m",
      "options": {
        "baseURL": "{env:DG_MS_M5M_BASE_URL}",
        "apiKey": "ds4-local"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8 Flash Next (oMLX)",
          "tools": true,
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "qwen3.8-flash-next:chat": {
          "name": "Qwen3.8 Flash Next (oMLX, no thinking)",
          "tools": true,
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "qwen3.8-flash-next:reasoner": {
          "name": "Qwen3.8 Flash Next (oMLX, reasoner)",
          "tools": true,
          "limit": {
            "context": 262144,
            "output": 262144
          }
        }
      }
    }
  }
}
