{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b-32k": {
          "name": "Qwen2.5 Coder 14B (32k)",
          "tools": true
        }
      }
    },
    "prismml": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "PrismML Local",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "prism-ml/Ternary-Bonsai-8B-mlx-2bit": {
          "name": "PrismML Bonsai 8B"
        }
      }
    }
  }
}
