#!/usr/bin/env python3
"""Generate the Oh My Posh palettes from the powerlevel10k theme files.

.p10k-themes/*.zsh is the source of truth for prompt colours, so p10k and Oh My
Posh show the same colours for the same theme. This rewrites the block between
the "# >>> palettes" / "# <<< palettes" markers in
.config/oh-my-posh/config.yaml, one palette per theme, named after the theme
file (catppuccin-latte, gruvbox_dark, ...). The config picks one with
$POSH_PALETTE, which .zshrc sets from the active theme.

Re-run after editing anything under .p10k-themes/:

    .bin/gen-posh-palettes

p10k variable (POWERLEVEL9K_*)  -> palette key
  VI_MODE_INSERT_BACKGROUND/_FOREGROUND -> vi_bg / vi_fg
  VI_MODE_OVERWRITE_BACKGROUND          -> overwrite_bg
  OS_ICON_BACKGROUND/_FOREGROUND        -> os_bg / os_fg
  DIR_BACKGROUND/_FOREGROUND            -> dir_bg / dir_fg
  VCS_CLEAN_FOREGROUND                  -> git_fg
  VCS_{CLEAN,MODIFIED,UNTRACKED,CONFLICTED}_BACKGROUND -> git_<state>
  VCS_LOADING_BACKGROUND                -> muted (right-prompt fallback grey)
  RBENV / NODE_VERSION / PYENV / GO_VERSION _BACKGROUND -> ruby/node/python/go
A bare 0 (ANSI black, used by the dark catppuccin themes) becomes #000000.
"""

import pathlib
import re
import sys

DOTFILES = pathlib.Path(__file__).resolve().parent.parent
SRC = DOTFILES / ".p10k-themes"
CONFIG = DOTFILES / ".config/oh-my-posh/config.yaml"
BEGIN, END = "# >>> palettes", "# <<< palettes"

KEYS = {
    "vi_bg": "VI_MODE_INSERT_BACKGROUND",
    "vi_fg": "VI_MODE_INSERT_FOREGROUND",
    "overwrite_bg": "VI_MODE_OVERWRITE_BACKGROUND",
    "os_bg": "OS_ICON_BACKGROUND",
    "os_fg": "OS_ICON_FOREGROUND",
    "dir_bg": "DIR_BACKGROUND",
    "dir_fg": "DIR_FOREGROUND",
    "git_fg": "VCS_CLEAN_FOREGROUND",
    "git_clean": "VCS_CLEAN_BACKGROUND",
    "git_modified": "VCS_MODIFIED_BACKGROUND",
    "git_untracked": "VCS_UNTRACKED_BACKGROUND",
    "git_conflicted": "VCS_CONFLICTED_BACKGROUND",
    "muted": "VCS_LOADING_BACKGROUND",
    "ruby": "RBENV_BACKGROUND",
    "node": "NODE_VERSION_BACKGROUND",
    "python": "PYENV_BACKGROUND",
    "go": "GO_VERSION_BACKGROUND",
}


def palette(path):
    text = path.read_text()
    lines = [f"    {path.stem}:"]
    for key, var in KEYS.items():
        m = re.search(rf"POWERLEVEL9K_{var}=('?)([^'\s]+)\1", text)
        if not m:
            sys.exit(f"{path.name}: POWERLEVEL9K_{var} not set")
        val = "#000000" if m.group(2) == "0" else m.group(2)
        lines.append(f'      {key}: "{val}"')
    return lines


def main():
    body = [f"{BEGIN} (generated by .bin/gen-posh-palettes -- do not edit by hand)"]
    for path in sorted(SRC.glob("*.zsh")):
        body += palette(path)
    body.append(END)

    config = CONFIG.read_text()
    start = config.index(BEGIN)
    start = config.rindex("\n", 0, start) + 1  # include the marker line's indent
    stop = config.index("\n", config.index(END)) + 1
    indent = "  "
    new = "\n".join(indent + l if l.startswith("#") else l for l in body) + "\n"
    CONFIG.write_text(config[:start] + new + config[stop:])
    print(f"wrote {len(list(SRC.glob('*.zsh')))} palettes -> {CONFIG.relative_to(DOTFILES)}")


main()
