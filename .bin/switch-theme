#!/usr/bin/env bash

# Theme switcher for terminal environment
# Usage: switch-theme <theme-name>
#        switch-theme --current   (or -q) print the active theme
#   or set TERMINAL_THEME env variable
#
# Available themes:
#   - catppuccin-mocha
#   - catppuccin-macchiato
#   - catppuccin-latte
#   - gruvbox-dark (gruvbox_dark)
#   - gruvbox-light (gruvbox_light)
#   - everforest-dark (everforest_dark)
#   - everforest-light (everforest_light)
#   - kanagawa-dark (kanagawa_dark)
#   - kanagawa-light (kanagawa_light)
#   - merino-dark (merino_dark)      Rex's built-in Merino Dark (GitHub dark palette)
#   - merino-light (merino_light)    Rex's built-in Merino Light (GitHub light palette)

set -e

DOTFILES="${HOME}/.dotfiles"

# --current / -q: print the active theme and exit. .nvim-theme holds the name
# exactly as passed to the last switch. The p10k and Alacritty symlinks are
# checked too; if one doesn't match (e.g. a partial switch or a hand edit),
# a warning goes to stderr. Runs before rex_panes so it stays instant.
# This shows the last theme switched to. Rex's own window theme is separate
# (it follows macOS light/dark); see .bin/rex-themes.
if [[ "$1" == "--current" || "$1" == "-q" ]]; then
  current="$(cat "${DOTFILES}/.nvim-theme" 2>/dev/null)"
  if [ -z "$current" ]; then
    echo "No theme recorded (${DOTFILES}/.nvim-theme missing)" >&2
    exit 1
  fi
  echo "$current"
  for link in .p10k-theme .config/alacritty/current-theme.toml; do
    target="$(basename "$(readlink "${DOTFILES}/${link}" 2>/dev/null)")"
    if [ "${target%.*}" != "$current" ]; then
      echo "  warning: ${link} -> ${target:-<missing>}" >&2
    fi
  done
  exit 0
fi

# Rex: print "SESSION BLOCK PROGRAM" for every pane on this machine. PROGRAM is
# the pane's current program (nvim, zsh, claude, ...) from `rex block call ...
# process`, the same lookup .bin/rex-sessions uses. Panes on other hosts are
# skipped, since they read their own machine's theme files. Prints nothing if
# Rex isn't installed or its server isn't running (--autostart=false).
rex_panes() {
  command -v rex &> /dev/null || return 0
  python3 -I - <<'PY'
import json, subprocess
def rex(*a):
    r = subprocess.run(["rex", "--autostart=false", *a], capture_output=True, text=True)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None
status = rex("server", "status", "--json")
if status:
    for s in rex("ls", "--json")["sessions"]:
        sid = s["session_id"]
        for b in (rex("block", "ls", "-s", sid, "--json") or {}).get("blocks", []):
            if b.get("host_id") != status["host_id"]:
                continue
            p = rex("block", "call", "-s", sid, "-b", b["block_id"], "process")
            fg = (p or {}).get("foreground") or {}
            if fg.get("name"):
                print(sid, b["block_id"], fg["name"].lstrip("-"))  # "-zsh" = login shell
PY
}
REX_PANES="$(rex_panes)"

# Get theme from argument or env variable
THEME="${1:-${TERMINAL_THEME}}"

if [ -z "$THEME" ]; then
  echo "Usage: switch-theme <theme-name>"
  echo "       switch-theme --current   (print the active theme)"
  echo "  or set TERMINAL_THEME environment variable"
  echo ""
  echo "Available themes:"
  echo "  - catppuccin-mocha"
  echo "  - catppuccin-macchiato"
  echo "  - catppuccin-latte"
  echo "  - gruvbox-dark"
  echo "  - gruvbox-light"
  echo "  - everforest-dark"
  echo "  - everforest-light"
  echo "  - kanagawa-dark"
  echo "  - kanagawa-light"
  echo "  - merino-dark"
  echo "  - merino-light"
  exit 1
fi

# Normalize theme names (handle both gruvbox-dark and gruvbox_dark)
case "$THEME" in
  gruvbox-dark) THEME="gruvbox_dark" ;;
  gruvbox-light) THEME="gruvbox_light" ;;
  everforest-dark) THEME="everforest_dark" ;;
  everforest-light) THEME="everforest_light" ;;
  kanagawa-dark) THEME="kanagawa_dark" ;;
  kanagawa-light) THEME="kanagawa_light" ;;
  merino-dark) THEME="merino_dark" ;;
  merino-light) THEME="merino_light" ;;
esac

# Validate theme exists
ALACRITTY_THEME="${DOTFILES}/.config/alacritty/themes/${THEME}.toml"
if [ ! -f "$ALACRITTY_THEME" ]; then
  echo "Error: Theme '$THEME' not found at $ALACRITTY_THEME"
  exit 1
fi

echo "Switching to theme: $THEME"

# Update Alacritty
echo "  ✓ Alacritty"
ln -sf "themes/${THEME}.toml" "${DOTFILES}/.config/alacritty/current-theme.toml"
touch "${DOTFILES}/.config/alacritty/alacritty.toml"

# Update Kitty
echo "  ✓ Kitty"
KITTY_THEME="${DOTFILES}/.config/kitty/themes/${THEME}.conf"
if [ -f "$KITTY_THEME" ]; then
  ln -sf "themes/${THEME}.conf" "${DOTFILES}/.config/kitty/current-theme.conf"
  # Kitty auto-reloads config, but we can trigger it explicitly
  if command -v kitty &> /dev/null && pgrep -x kitty > /dev/null; then
    killall -SIGUSR1 kitty 2>/dev/null || true
    echo "    → Reloaded kitty config"
  fi
else
  echo "    → Warning: Kitty theme not found: $KITTY_THEME"
fi

# Update Ghostty
echo "  ✓ Ghostty"
GHOSTTY_THEME="${DOTFILES}/.config/ghostty/themes/${THEME}.conf"
if [ -f "$GHOSTTY_THEME" ]; then
  ln -sf "themes/${THEME}.conf" "${DOTFILES}/.config/ghostty/current-theme.conf"
  # Ghostty does not watch its config; reload with Cmd+Shift+, in open windows.
  echo "    → Press Cmd+Shift+, in Ghostty to reload"
else
  echo "    → Warning: Ghostty theme not found: $GHOSTTY_THEME"
fi

# Update Neovim
echo "  ✓ Neovim"
echo "${THEME}" > "${DOTFILES}/.nvim-theme"

# Map theme to nvim colorscheme
NVIM_COLORSCHEME=""
case "$THEME" in
  gruvbox_dark|gruvbox_light)
    NVIM_COLORSCHEME="gruvbox"
    ;;
  catppuccin-mocha)
    NVIM_COLORSCHEME="catppuccin-mocha"
    ;;
  catppuccin-macchiato)
    NVIM_COLORSCHEME="catppuccin-macchiato"
    ;;
  catppuccin-latte)
    NVIM_COLORSCHEME="catppuccin-latte"
    ;;
  everforest_dark|everforest_light)
    NVIM_COLORSCHEME="everforest"
    ;;
  kanagawa_dark)
    NVIM_COLORSCHEME="kanagawa-wave"
    ;;
  kanagawa_light)
    NVIM_COLORSCHEME="kanagawa-lotus"
    ;;
  merino_dark)
    NVIM_COLORSCHEME="github_dark_default"
    ;;
  merino_light)
    NVIM_COLORSCHEME="github_light_default"
    ;;
esac

# Send colorscheme command to running nvim instances in tmux
if command -v tmux &> /dev/null && tmux list-panes -a -F '#{pane_id} #{pane_current_command}' 2>/dev/null | grep -q nvim; then
  # Set background for gruvbox and everforest
  if [[ "$THEME" == "gruvbox_light" || "$THEME" == "everforest_light" || "$THEME" == "kanagawa_light" || "$THEME" == "merino_light" ]]; then
    tmux list-panes -a -F '#{pane_id} #{pane_current_command}' | grep nvim | awk '{print $1}' | while read pane; do
      tmux send-keys -t "$pane" Escape
      tmux send-keys -t "$pane" ":set background=light" Enter
      tmux send-keys -t "$pane" ":colorscheme ${NVIM_COLORSCHEME}" Enter
    done
  else
    tmux list-panes -a -F '#{pane_id} #{pane_current_command}' | grep nvim | awk '{print $1}' | while read pane; do
      tmux send-keys -t "$pane" Escape
      tmux send-keys -t "$pane" ":set background=dark" Enter
      tmux send-keys -t "$pane" ":colorscheme ${NVIM_COLORSCHEME}" Enter
    done
  fi
  echo "    → Updated running nvim instances"
fi

# Same for nvim running in Rex panes. Escape is its own key press so nvim
# doesn't read Escape followed by ":" as Alt+:.
case "$THEME" in
  *_light|catppuccin-latte) NVIM_BG="light" ;;
  *) NVIM_BG="dark" ;;
esac
n=0
while read -r sid blk prog; do
  [ "$prog" = "nvim" ] || continue
  rex send-key -s "$sid" -b "$blk" escape
  rex send -s "$sid" -b "$blk" ":set background=${NVIM_BG} | colorscheme ${NVIM_COLORSCHEME}"$'\r'
  n=$((n + 1))
done <<< "$REX_PANES"
[ "$n" -gt 0 ] && echo "    → Updated $n nvim pane(s) in Rex"

# Update Tmux
echo "  ✓ Tmux"
# Map theme names to tmux theme names
TMUX_THEME=""
case "$THEME" in
  gruvbox_dark)
    TMUX_THEME="gruvbox-dark"
    ;;
  gruvbox_light)
    TMUX_THEME="gruvbox-light"
    ;;
  catppuccin-mocha)
    TMUX_THEME="catppuccin-mocha"
    ;;
  catppuccin-macchiato)
    TMUX_THEME="catppuccin-macchiato"
    ;;
  catppuccin-latte)
    TMUX_THEME="catppuccin-latte"
    ;;
  everforest_dark)
    TMUX_THEME="everforest-dark"
    ;;
  everforest_light)
    TMUX_THEME="everforest-light"
    ;;
  kanagawa_dark)
    TMUX_THEME="kanagawa-dark"
    ;;
  kanagawa_light)
    TMUX_THEME="kanagawa-light"
    ;;
  merino_dark)
    TMUX_THEME="merino-dark"
    ;;
  merino_light)
    TMUX_THEME="merino-light"
    ;;
esac

echo "set -g @theme \"${TMUX_THEME}\"" > "${DOTFILES}/.tmux-theme"

# Reload tmux config if tmux is running
if command -v tmux &> /dev/null && tmux list-sessions &>/dev/null 2>&1; then
  tmux source-file ~/.config/tmux/tmux.conf
  echo "    → Reloaded tmux config"
fi

# Update Lazygit
echo "  ✓ Lazygit"
LAZYGIT_CONFIG="${DOTFILES}/.config/lazygit/config.yml"
LAZYGIT_THEME="${DOTFILES}/.config/lazygit/themes/${THEME}.yml"

if [ -f "$LAZYGIT_THEME" ]; then
  # Create config with theme content
  cat > "$LAZYGIT_CONFIG" << 'EOF'
gui:
  theme:
EOF
  # Indent and append theme content
  sed 's/^/    /' "$LAZYGIT_THEME" >> "$LAZYGIT_CONFIG"
else
  echo "    → Warning: Lazygit theme file not found: $LAZYGIT_THEME"
fi

# Update Powerlevel10k
echo "  ✓ Powerlevel10k"
ln -sf "${DOTFILES}/.p10k-themes/${THEME}.zsh" "${DOTFILES}/.p10k-theme"

# Reload p10k in all running zsh shells (including current shell if in tmux)
if command -v tmux &> /dev/null && tmux list-sessions &>/dev/null 2>&1; then
  tmux list-panes -a -F '#{pane_id} #{pane_current_command}' | grep zsh | awk '{print $1}' | while read pane; do
    tmux send-keys -t "$pane" " source ~/.p10k.zsh" Enter
  done
  echo "    → Reloaded p10k in running shells"
fi

# Same for Rex panes sitting at a zsh prompt. Panes running something else
# (claude, lazygit, ...) are left alone so nothing gets typed into them. The
# leading space keeps the command out of zsh history. This shell is running
# switch-theme, not zsh, so it gets skipped; hence the reminder below.
# Ctrl+C first discards any half-typed command line (in vi insert or normal
# mode) so the source command isn't appended to it and run as one line.
n=0
while read -r sid blk prog; do
  [ "$prog" = "zsh" ] || continue
  rex send-key -s "$sid" -b "$blk" ctrl+c
  rex send -s "$sid" -b "$blk" " source ~/.p10k.zsh"$'\r'
  n=$((n + 1))
done <<< "$REX_PANES"
[ "$n" -gt 0 ] && echo "    → Reloaded p10k in $n idle zsh pane(s) in Rex"
echo "    → Run 'source ~/.p10k.zsh' in this shell to apply here"

# Update Claude Code theme preference
echo "  ✓ Claude Code"
case "$THEME" in
  gruvbox_light|catppuccin-latte|everforest_light|kanagawa_light|merino_light)
    export CLAUDE_CODE_THEME="light"
    echo "export CLAUDE_CODE_THEME=light" > "${DOTFILES}/.claude-theme"
    ;;
  gruvbox_dark|catppuccin-mocha|catppuccin-macchiato|everforest_dark|kanagawa_dark|merino_dark)
    export CLAUDE_CODE_THEME="dark"
    echo "export CLAUDE_CODE_THEME=dark" > "${DOTFILES}/.claude-theme"
    ;;
esac

echo ""
echo "Theme switched successfully!"
echo "Note: Alacritty and Kitty reload automatically; Ghostty needs Cmd+Shift+,. New shells will use the new theme."
