# === CATPPUCCIN-MOCHA-DARK (pure black bg; segment colours identical to catppuccin-mocha) ===
# Grey blocks (vi mode, os icon, version fallbacks) use overlay2 #9399b2, not
# overlay0 #6c7086: black text on #6c7086 is only 4.3:1, under the 4.5:1 a
# terminal minimum-contrast rule enforces -- the likely reason Rex drew the
# vi-mode letter white. #9399b2 gives ~7.5:1.
typeset -g POWERLEVEL9K_DIR_BACKGROUND='#89b4fa'            # catppuccin blue
typeset -g POWERLEVEL9K_DIR_FOREGROUND=0                    # pure black #000000
typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND=0
typeset -g POWERLEVEL9K_DIR_ANCHOR_FOREGROUND=0
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND='#a6e3a1'      # catppuccin green
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND=0
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND='#f9e2af'   # catppuccin yellow
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND=0
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND='#a6e3a1'  # catppuccin green
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND=0
typeset -g POWERLEVEL9K_VCS_CONFLICTED_BACKGROUND='#f38ba8' # catppuccin red
typeset -g POWERLEVEL9K_VCS_CONFLICTED_FOREGROUND=0
typeset -g POWERLEVEL9K_VCS_LOADING_BACKGROUND='#9399b2'   # catppuccin overlay2 (was overlay0 #9399b2, as tmux uses)
typeset -g POWERLEVEL9K_VI_MODE_FOREGROUND=0
