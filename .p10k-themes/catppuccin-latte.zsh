# === CATPPUCCIN-LATTE (LIGHT) ===
# Segment backgrounds are the Catppuccin hues darkened (lightness only, hue and
# saturation kept) until the #eff1f5 text on them reaches >= 5:1 WCAG contrast.
# The stock latte accents only gave 2.3-2.8:1, which read as muted-on-muted.
# Was -> now: lavender #7287fd -> #0b58f1 (blue), yellow #df8e1d -> #8e5a12,
# green #40a02b -> #2e741f, red #d20f39 -> #cb0e37, grey #9ca0b0 -> #62667a.
# The flat right prompt reuses these as foregrounds on #eff1f5, so it gets the
# same contrast.
typeset -g POWERLEVEL9K_DIR_BACKGROUND='#0b58f1'            # catppuccin blue #1e66f5, darkened (was lavender #7287fd)
typeset -g POWERLEVEL9K_DIR_FOREGROUND='#eff1f5'            # catppuccin bg (off-white)
typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND='#eff1f5'
typeset -g POWERLEVEL9K_DIR_ANCHOR_FOREGROUND='#eff1f5'
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND='#2e741f'      # catppuccin green #40a02b, darkened
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND='#eff1f5'
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND='#8e5a12'   # catppuccin yellow #df8e1d, darkened
