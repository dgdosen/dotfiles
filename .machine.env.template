# Machine-specific configuration
# Copy to ~/.machine.env and customize per machine
# This file is sourced by .zshrc (and can be sourced by any shell)

# Machine name (for identification in scripts/logs)
export MACHINE_NAME="changeme"

# Dropbox locations (vary by machine/OS version)
export DROPBOX_PERSONAL="$HOME/Dropbox (Personal)"
export DROPBOX_BUSINESS="$HOME/makerboarding Dropbox/Daniel Dosen"

# Dropbox symlink target (used by dot_setup.sh for ~/dropboxm)
export DROPBOXM_TARGET="$DROPBOX_BUSINESS"

# Launchd agents to run on this machine (space-separated list)
# Options: backup brewupdate dotupdate fetch logrotate touch db dw_db drf_watch quantified_status
# lincoln: "backup brewupdate dotupdate fetch logrotate db dw_db drf_watch quantified_status"
#
# NOTE: nothing reads this variable. It is documentation of intent only —
# selecting launchd agents is still a manual symlink into ~/Library/LaunchAgents.
# For the project_b jobs, use the switches below, which ARE read.
export LAUNCHD_AGENTS="backup brewupdate dotupdate fetch logrotate"

# ── project_b job switches ───────────────────────────────────────────────────
#
# One switch per SERVICE. Read by daily/_jobs.sh, which every project_b job
# script sources (the container launchers get it via daily/container/_lib.sh).
# A job whose switch is off logs why and exits 0 — it stays installed, stays
# scheduled, and still proves it fired. It is NOT unloaded: `launchctl list`
# prints `-` for a job that never ran, so unloading makes "off on purpose" and
# "quietly broken" the same observation, which is the one failure this fleet is
# worst at noticing.
#
# Both variants of a service share ONE switch, by design:
#   project_b_bris_fetch.sh  and  project_b_bris_fetch.container.sh
#     -> PROJECT_B_BRIS_FETCH
# Native and container halves share dropoff directories, git working trees and
# API targets, and only the container side takes a lock — so running both is
# destructive. One knob per service means the config cannot express that state.
#
# Values: on | off | off:<reason>   (also accepted as off: 0, no, false)
# The reason is logged, which is what you want mid-migration:
#   export PROJECT_B_BRIS_FETCH="off: moved to the droplet 2026-08-14"
#
# FAIL OPEN: unset, empty, or unrecognised means the job RUNS. A typo here must
# never be able to silently stop the pipeline.

# Fleet-wide kill switch. Leave unset in normal operation.
# export PROJECT_B_JOBS="off: cutting over to the droplet"

# Which implementation this machine runs: container | native
#
# This does NOT choose the implementation — the installed launch agent does, and
# the plist pointing at the exact script that ran is what keeps "what executed?"
# answerable. This ASSERTS it: a job script of the wrong variant refuses to run
# (exit 1, loudly) instead of quietly scraping into the same git tree and
# dropoff directories as its counterpart. Same shape as assert_prod_env.
#
# Only applies to services that have BOTH variants. Container-only jobs
# (twinspires_data) and host-only jobs (the Rails DB pair, fetch_scratches) are
# never refused. Unset asserts nothing.
#
# dg-mba-m5: container
export PROJECT_B_MODE="${PROJECT_B_MODE:-container}"

# --- Scrapers: safe to switch off, work accumulates and drains on the next run
export PROJECT_B_DRF_FETCH="${PROJECT_B_DRF_FETCH:-on}"
export PROJECT_B_DRF_DEBUT_FETCH="${PROJECT_B_DRF_DEBUT_FETCH:-on}"
export PROJECT_B_HARRINGTON_SCRAPE="${PROJECT_B_HARRINGTON_SCRAPE:-on}"
export PROJECT_B_TMRACINGDATA_SCRAPE="${PROJECT_B_TMRACINGDATA_SCRAPE:-on}"
export PROJECT_B_PROGRESSIVE_BREEDING_SCRAPE="${PROJECT_B_PROGRESSIVE_BREEDING_SCRAPE:-on}"

# --- Safe to switch off, but the backlog compounds
# gmax/egps files pile up in to_be_reprocessed and the final `-r` pass
# re-scrapes all of them: 6 files took 59 minutes on 2026-08-11, against a
# 5400s per-invocation bound. A month off makes the first run back very long.
export PROJECT_B_GMAX_EGPS_AUDIT="${PROJECT_B_GMAX_EGPS_AUDIT:-on}"

# --- Off is free briefly, LOSSY eventually: these scrape a rolling date window
# from sites that do not keep history forever. Off for days is fine (the window
# is re-fetched); off long enough and those entries/charts are simply gone.
# Establish the real retention per site before leaning on this.
export PROJECT_B_BRIS_FETCH="${PROJECT_B_BRIS_FETCH:-on}"
export PROJECT_B_EQUIBASE_PROGRAM_SCRAPE="${PROJECT_B_EQUIBASE_PROGRAM_SCRAPE:-on}"
export PROJECT_B_EQUIBASE_RESULTS_SCRAPE="${PROJECT_B_EQUIBASE_RESULTS_SCRAPE:-on}"
export PROJECT_B_TWINSPIRES_DATA_SCRAPE="${PROJECT_B_TWINSPIRES_DATA_SCRAPE:-on}"

# --- DO NOT SWITCH OFF: live odds, fires every 60s, CANNOT be backfilled.
# Data not captured never existed. Off is not a delay here, it is a hole.
export PROJECT_B_TWINSPIRES_SCRAPE="${PROJECT_B_TWINSPIRES_SCRAPE:-on}"

# --- Host-only (Rails/Postgres on the machine itself, no container variant).
# These run on every Mac; a droplet would leave them off/absent.
export PROJECT_B_DB="${PROJECT_B_DB:-on}"
export PROJECT_B_DW_DB="${PROJECT_B_DW_DB:-on}"
export PROJECT_B_FETCH_SCRATCHES="${PROJECT_B_FETCH_SCRATCHES:-on}"

# Not switchable, deliberately:
#   project_b_container_status  — the observer. Switch it off and you go blind.
#   project_b_podman            — VM pre-warm, infrastructure for everything else.
#   project_b_repository_sync   — the lone #!/bin/bash script; _jobs.sh is zsh.
